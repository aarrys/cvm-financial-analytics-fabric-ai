# =============================================================================
# GENERAL
# =============================================================================

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor & IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs
*.log
logs/

# Temporary files (the downloader writes *.tmp before the atomic rename)
*.tmp
*.temp
*.bak
*.orig
.cache/

# =============================================================================
# ENVIRONMENT & SECRETS
# =============================================================================

.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.p12
secrets/
config/local.*

# =============================================================================
# PYTHON
# =============================================================================

__pycache__/
*.py[cod]
.venv/
venv/
env/
.Python
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local, machine-specific lock (not versioned; pyproject.toml is the source of truth)
requirements-lock.txt

# =============================================================================
# TESTING & COVERAGE
# =============================================================================

.coverage
.coverage.*
htmlcov/
coverage.xml

# =============================================================================
# DATA (medallion layers)
# =============================================================================

# Raw and standardized data are large and reproducible from the CVM source.
# Gold is not ignored: it may be versioned if small.
# CSVs elsewhere (tests/data/, powerbi/tests/) must stay versioned.
data/bronze/*
data/silver/*
!data/**/.gitkeep

# Local vector index (RAG, Stage D)
rag_store/

# =============================================================================
# POWER BI
# =============================================================================

**/.pbi/localSettings.json
**/.pbi/cache.abf